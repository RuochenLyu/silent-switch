    "quit.confirm.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Quitting disables all shortcuts. Closing the settings window keeps Silent Switch running in the background." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "退出应用会停用所有快捷键；关闭设置窗口则会继续在后台运行。" } }
      }
    },
    "quit.confirm.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Quit Silent Switch?" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "退出 Silent Switch？" } }
      }
    },
    "runtime.status.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Closing this window keeps Silent Switch running in the background." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭设置窗口后，Silent Switch 仍会在后台运行。" } }
