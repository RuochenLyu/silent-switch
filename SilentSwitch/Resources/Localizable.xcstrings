      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Run quietly in the background after login without opening Settings." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "登录后静默在后台运行，不打开设置窗口。" } }
